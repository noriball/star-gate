{
  "name": "star-gate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "samples": "node scripts/make-samples.mjs",
    "dev:https": "node scripts/dev-cert.mjs && VITE_HTTPS=1 vite --host",
    "preview": "vite build && vite preview",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
